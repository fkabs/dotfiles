#!/bin/zsh
#
# .zsh_aliases - Set whatever shell aliases you want.
#

# General aliases
alias ls="ls -h --color=auto"
alias la="ls -lah --color=auto"
alias ll="ls -lh --color=auto"

# Shortcuts for easier navigation
alias ~="cd ~"
alias -- -="cd -"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"

# Use bat (https://github.com/sharkdp/bat) instead of cat
alias cat="bat"
alias cata="bat -A"
alias rcat='bat --paging=never'
alias rcata='bat -A --paging=never'

# Use fzf with bat for previewing files as default
alias fzf='fzf --preview "bat --color=always --style=numbers,changes --line-range=:500 {}"'

# Clipboard (macOS has pbcopy/pbpaste natively; shim them on Linux)
if (( $+commands[wl-copy] )); then
    alias pbcopy=wl-copy pbpaste=wl-paste
elif (( $+commands[xclip] )); then
    alias pbcopy='xclip -selection clipboard' pbpaste='xclip -selection clipboard -o'
fi

# IP addresses
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
if (( $+commands[ipconfig] )); then
    alias localip="ipconfig getifaddr en0"
else
    alias localip="ip -4 -o addr show scope global | awk '{print \$4}' | cut -d/ -f1"
fi
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Intuitive map function
# For example, to list all directories that contain a certain file:
# find . -name .gitattributes | map dirname
alias map="xargs -n1"

# Make and change directory
alias mkcd='(){mkdir -p "$1"; cd "$1"}'

# Print each PATH entry on a separate line
alias showpath='echo -e ${PATH//:/\\n}'
alias showfpath='echo -e ${FPATH//:/\\n}'
alias showipath='echo -e ${INFOPATH//:/\\n}'
alias showmpath='echo -e ${MANPATH//:/\\n}'

# Use uv pip
alias uvp='uv pip'

# Claude Code
alias cc='claude'
alias ccdanger='claude --dangerously-skip-permissions'

# Docker
alias docker-stop-all='docker ps -q | xargs -r docker stop'
alias docker-rm-all='docker ps -aq | xargs -r docker rm'

# Tmux
alias tm='tmux' # Force tmux to use 256 colors

# Use nvim as default editor
alias vi='nvim'
alias vim='nvim'

# Enable aliases to be sudo’ed and preserve the environment
alias sudo='sudo -E HOME=$HOME '

# Please = sudo with last command
alias please='sudo -E HOME=$HOME '

# Get week number
alias week='date +%V'
